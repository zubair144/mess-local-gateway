GATEWAY_PORT=5050
GATEWAY_HOST=0.0.0.0
GATEWAY_HOST_IP=192.168.1.4

ZK_ADMS_PORT=8080
ZK_ADMS_HOST=0.0.0.0
ZK_DEVICE_IP=192.168.1.16
ZK_DEVICE_PORT=4370
ZK_COMM_KEY=0

PRINTER_IP=192.168.1.17
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=5000

SQLITE_PATH=./data/mess-local.db

LOG_LEVEL=info

FACE_ENABLED=true
QR_ENABLED=true
PRINTER_ENABLED=true

# Set false to keep Face/QR as print-only hardware tests
HARDWARE_PROCESS_MEALS=true

FACE_DUPLICATE_WINDOW_MS=10000
QR_DUPLICATE_WINDOW_MS=3000

TIMEZONE=Asia/Karachi
DASHBOARD_POLL_MS=3000
DEMO_FACE_DEVICE_USER_ID=1
# Development only: force meal type (breakfast|lunch|dinner)
DEV_FORCE_MEAL=
PRINT_DECLINED_RECEIPTS=false

# Cloud gateway sync (web portal base URL, not MongoDB)
CLOUD_API_URL=https://mess-master-lac.vercel.app
GATEWAY_ID=MESS-01
GATEWAY_API_KEY=your-strong-test-key

# Master switch (SYNC_ENABLED is a legacy alias for CLOUD_SYNC_ENABLED)
CLOUD_SYNC_ENABLED=true
SYNC_ENABLED=true

# Independent workers — Demo / master-data test: pull ON, push OFF
CLOUD_PULL_ENABLED=true
CLOUD_PUSH_ENABLED=false
HEARTBEAT_ENABLED=true

SYNC_PULL_INTERVAL_MS=15000
SYNC_PUSH_INTERVAL_MS=10000
HEARTBEAT_INTERVAL_MS=30000

SYNC_BATCH_SIZE=50
SYNC_REQUEST_TIMEOUT_MS=10000

SYNC_MAX_ATTEMPTS=10
SYNC_RETRY_BASE_MS=5000
SYNC_RETRY_MAX_MS=300000
